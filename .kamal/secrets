# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# Everything below resolves at deploy time on the machine running `kamal`.
# Nothing here is a literal value, so this file stays safe to commit.

# Decrypts config/credentials/production.yml.enc.
#
# NOT config/master.key -- that one decrypts config/credentials.yml.enc, which
# is a different file with a different key. Because the image runs with
# RAILS_ENV=production, Rails reads the production.yml.enc variant, so handing
# it master.key makes the container boot and then die unable to decrypt.
RAILS_MASTER_KEY=$(cat config/credentials/production.key)

# GHCR credentials, kept in the encrypted production credentials so they travel
# with the repo instead of living in a shell profile. Add them with:
#   RAILS_ENV=production bin/rails credentials:edit
# under:
#   kamal:
#     registry_username: <github-login>
#     registry_password: <PAT with write:packages>
KAMAL_REGISTRY_USERNAME=$(RAILS_ENV=production bin/rails credentials:fetch kamal.registry_username)
KAMAL_REGISTRY_PASSWORD=$(RAILS_ENV=production bin/rails credentials:fetch kamal.registry_password)

# Postgres accessory credentials. POSTGRES_PASSWORD initialises the database on
# first boot; DB_PASSWORD is what the app connects with - they must match.
#
# Held in the encrypted production credentials as kamal.postgres_password.
# Note it only takes effect when the accessory's data directory is first
# created; rotating it later needs an ALTER ROLE inside Postgres as well.
POSTGRES_PASSWORD=$(RAILS_ENV=production bin/rails credentials:fetch kamal.postgres_password)
DB_PASSWORD=$POSTGRES_PASSWORD

# Origin TLS certificate served by kamal-proxy. Cloudflare proxies this
# hostname, so it re-encrypts to this origin and the certificate only has to
# satisfy Cloudflare, not public browsers.
TLS_CERTIFICATE_PEM=$(RAILS_ENV=production bin/rails credentials:fetch kamal.tls_certificate_pem)
TLS_PRIVATE_KEY_PEM=$(RAILS_ENV=production bin/rails credentials:fetch kamal.tls_private_key_pem)

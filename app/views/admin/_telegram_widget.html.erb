<%# Telegram Login Widget — used on the login page and the My Account page.
    Signed out it authenticates; signed in the same callback links the account. %>
<script async src="https://telegram.org/js/telegram-widget.js?22"
        data-telegram-login="<%= Rails.application.credentials.dig(:oauth, :telegram, :bot_username) %>"
        data-size="large"
        data-auth-url="<%= omniauth_callback_url(:admin, :telegram) %>">
</script>

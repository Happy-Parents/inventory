#!/bin/bash -e

# Entrypoint for the development container (see Dockerfile.dev).
#
# Waits for Postgres, keeps the bundle in sync with the Gemfile, and prepares
# the database before booting the web server.

if [ -n "${DB_HOST}" ]; then
  echo "==> Waiting for Postgres at ${DB_HOST}:${DB_PORT:-5432}"
  until pg_isready --quiet \
    --host="${DB_HOST}" \
    --port="${DB_PORT:-5432}" \
    --username="${DB_USERNAME:-postgres}"; do
    sleep 1
  done
fi

# Rebuilding the image is the intended way to pick up Gemfile changes, but this
# keeps a running container usable immediately after someone edits the Gemfile.
if ! bundle check > /dev/null 2>&1; then
  echo "==> Bundle out of date, installing gems"
  bundle install
fi

# If running the rails server then create or migrate existing database
if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  rm -f tmp/pids/server.pid
  ./bin/rails db:prepare
fi

exec "${@}"

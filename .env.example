# Template for the Compose environment files. Copy, don't edit in place:
#
#   cp .env.example .env               # optional, development overrides
#   cp .env.example .env.production    # required for compose.production.yaml
#
# Real .env* files are gitignored -- keep secrets out of the repository.
#
# Development (compose.yaml) works with no env file at all; every variable
# below falls back to a sane default. Production (compose.production.yaml)
# requires RAILS_MASTER_KEY and POSTGRES_PASSWORD and refuses to start without
# them, and must be passed explicitly:
#
#   docker compose --env-file .env.production -f compose.production.yaml up -d


# --- Secrets (production) ---------------------------------------------------

# Contents of config/credentials/production.key -- a single 32-char hex string.
# Decrypts config/credentials/production.yml.enc. The key file is kept out of
# the image by .dockerignore, so it has to arrive through the environment.
#   cat config/credentials/production.key
RAILS_MASTER_KEY=

# Password for the Postgres role below. Generate one, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=


# --- Database ---------------------------------------------------------------

# Postgres role. Owns the databases and needs CREATEDB, because db:prepare
# creates the primary/cache/queue/cable databases on first boot.
POSTGRES_USER=hp_inventory

# Primary database name in production. The solid_cache / solid_queue /
# solid_cable database names are derived from it (_cache, _queue, _cable)
# unless overridden -- see the comment in config/database.yml.
DB_NAME=hp_inventory_production

# Development only: host port that the db service is published on. Defaults to
# 5433 so it never collides with a Postgres installed on the host.
DB_PORT_HOST=5433


# --- Web --------------------------------------------------------------------

# Host port for the app. Development defaults to 3000, production to 80.
# WEB_PORT=3000

# Puma threads, and therefore the Active Record connection pool size.
# Defaults to 5 in development and 3 in production; uncomment to override.
# RAILS_MAX_THREADS=3

# Production only.
RAILS_LOG_LEVEL=info

# Solid Queue worker processes in the jobs service (production only).
JOB_CONCURRENCY=1

# Connection pool for the jobs service. Solid Queue needs (worker threads + 2),
# and config/queue.yml sets 3 threads, so keep this at 5 or above.
JOB_MAX_THREADS=5

# Image tag built/run by compose.production.yaml. Bump to keep releases apart.
APP_VERSION=latest
